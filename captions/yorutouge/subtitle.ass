Dialogue: 0,0:00:20.07,0:00:21.57,Default,,0,0,0,,（小さな爆発音）
Dialogue: 0,0:00:21.75,0:00:27.92,Default,,0,0,0,,（時計の針の音…）（続く）
Dialogue: 0,0:00:51.09,0:00:59.01,Default,,0,0,0,,（少しずつ音が高く、大きくなっていく）
Dialogue: 0,0:01:00.00,0:01:02.36,Default,,0,0,0,,（小さな爆発音）
Dialogue: 0,0:01:02.48,0:01:04.77,Default,,0,0,0,,（静かになる）
Dialogue: 0,0:01:04.88,0:01:12.29,Default,,0,0,0,,（♪～ 音楽が、会場をぐるぐる回りながら聴こえ始める）
Dialogue: 0,0:01:12.34,0:01:19.79,Default,,0,0,0,,（♪～）
Dialogue: 0,0:01:27.25,0:01:31.03,Default,,0,0,0,,日の沈む夜が訪れて
Dialogue: 0,0:01:31.28,0:01:34.60,Default,,0,0,0,,暗い心がラクになる
Dialogue: 0,0:01:34.88,0:01:38.27,Default,,0,0,0,,月の灯りに照らされて
Dialogue: 0,0:01:38.53,0:01:42.00,Default,,0,0,0,,山の陰とひとつになる
Dialogue: 0,0:01:42.26,0:01:46.04,Default,,0,0,0,,日照りばかりが続く日は
Dialogue: 0,0:01:46.25,0:01:49.75,Default,,0,0,0,,暗い心がたまります
Dialogue: 0,0:01:49.95,0:01:53.29,Default,,0,0,0,,さみしい夜は万華鏡
Dialogue: 0,0:01:53.47,0:01:57.04,Default,,0,0,0,,よろずの月に焼かれます
Dialogue: 0,0:01:57.22,0:02:00.92,Default,,0,0,0,,鬼さんこちら 手のなるほうへ
Dialogue: 0,0:02:00.97,0:02:04.73,Default,,0,0,0,,おばけはあちら 太鼓のほうへ
Dialogue: 0,0:02:04.78,0:02:08.65,Default,,0,0,0,,おどろ まわろ 陰の世界で
Dialogue: 0,0:02:08.73,0:02:12.31,Default,,0,0,0,,抜けてゆきましょ体から
Dialogue: 0,0:02:14.20,0:02:21.53,Default,,0,0,0,,（青い光から音楽がぐるぐる回って聴こえる）
Dialogue: 0,0:02:21.64,0:02:27.27,Default,,0,0,0,,（♪～）
Dialogue: 0,0:02:49.86,0:02:57.24,Default,,0,0,0,,（♪～）
Dialogue: 0,0:03:13.68,0:03:29.19,Default,,0,0,0,,僕の番
Dialogue: 0,0:03:30.66,0:03:33.51,Default,,0,0,0,,（♪～）
Dialogue: 0,0:03:36.30,0:03:39.17,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:03:41.95,0:03:44.77,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:03:47.59,0:03:49.77,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:03:50.42,0:03:52.75,Default,,0,0,0,,♪ Hah~... ♪
Dialogue: 0,0:03:53.31,0:03:56.73,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:03:58.82,0:04:01.68,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:04:04.43,0:04:07.67,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:04:10.12,0:04:14.98,Default,,0,0,0,,♪ Hah... ♪
Dialogue: 0,0:04:15.83,0:04:21.43,Default,,0,0,0,,転生 {昇天抄|しょうてんしょう} 別の生き物に変わるまで
Dialogue: 0,0:04:21.49,0:04:26.91,Default,,0,0,0,,転生 {双転生|そうてんしょう} 何度も治そう
Dialogue: 0,0:04:27.05,0:04:32.65,Default,,0,0,0,,転生 {昇天抄|しょうてんしょう} 二人 {物の怪|もののけ}になるまで
Dialogue: 0,0:04:32.75,0:04:35.60,Default,,0,0,0,,転生 {双転生|そうてんしょう}…
Dialogue: 0,0:04:35.64,0:04:44.46,Default,,0,0,0,,（♪～）
Dialogue: 0,0:04:57.57,0:05:05.03,Default,,0,0,0,,あっという間になくなる
Dialogue: 0,0:05:06.46,0:05:10.25,Default,,0,0,0,,かなしい わたあめ
Dialogue: 0,0:05:10.53,0:05:20.12,Default,,0,0,0,,ずっと ずっと 頭がからっからっから
Dialogue: 0,0:05:21.83,0:05:25.22,Default,,0,0,0,,むかしに むかしに
Dialogue: 0,0:05:25.34,0:05:30.38,Default,,0,0,0,,あの頃に戻ってお願い
Dialogue: 0,0:05:30.97,0:05:37.64,Default,,0,0,0,,（♪～）
Dialogue: 0,0:07:30.44,0:07:34.24,Default,,0,0,0,,千人くわえて{黄泉|よみ}の穴
Dialogue: 0,0:07:34.30,0:07:38.41,Default,,0,0,0,,一万人飲み込み{黄泉|よみ}の国
Dialogue: 0,0:07:38.59,0:07:42.78,Default,,0,0,0,,ほら静かだね でも悲しいね
Dialogue: 0,0:07:42.85,0:07:47.18,Default,,0,0,0,,でもあんまり苦しくないんだね
Dialogue: 0,0:07:47.71,0:07:50.67,Default,,0,0,0,,心にぽっかり風の穴
Dialogue: 0,0:07:50.86,0:07:54.34,Default,,0,0,0,,寝て覚めても南の旅人が
Dialogue: 0,0:07:54.53,0:07:58.15,Default,,0,0,0,,ご{神木|しんぼく}くり抜いた笛吹くよ
Dialogue: 0,0:07:58.45,0:08:01.84,Default,,0,0,0,,いつまでも響いてやまないよ
Dialogue: 0,0:08:02.14,0:08:05.33,Default,,0,0,0,,ナイショのお宝地図の道
Dialogue: 0,0:08:05.37,0:08:08.86,Default,,0,0,0,,あなただけに聞かせる夢の宿
Dialogue: 0,0:08:09.02,0:08:12.60,Default,,0,0,0,,夢フワフワゆめゆめ疑わぬ
Dialogue: 0,0:08:12.65,0:08:16.58,Default,,0,0,0,,一眠りでぐっすり二億年
Dialogue: 0,0:08:16.61,0:08:20.56,Default,,0,0,0,,（♪～）
Dialogue: 0,0:08:23.83,0:08:27.63,Default,,0,0,0,,ここは {万物霊長|ばんぶつれいちょう}夢見る{旅籠屋|はたごや}
Dialogue: 0,0:08:27.65,0:08:30.43,Default,,0,0,0,,ようこそおこしや {黄泉|よみ}の宿
Dialogue: 0,0:08:30.45,0:08:33.71,Default,,0,0,0,,たぶん近くに来たかもしれない
Dialogue: 0,0:08:33.73,0:08:36.00,Default,,0,0,0,,寂しいけど苦しくない
Dialogue: 0,0:08:36.18,0:08:40.14,Default,,0,0,0,,そこは 悲しい生き物集まるよ
Dialogue: 0,0:08:40.16,0:08:43.30,Default,,0,0,0,,ほら {極楽天国|ごくらくてんごく}首枕
Dialogue: 0,0:08:43.33,0:08:46.72,Default,,0,0,0,,これお涙頂戴招待状
Dialogue: 0,0:08:46.99,0:08:50.21,Default,,0,0,0,,いつでも届ける準備はできてます
Dialogue: 0,0:08:50.43,0:08:53.37,Default,,0,0,0,,ラララ…
Dialogue: 0,0:08:53.44,0:08:56.42,Default,,0,0,0,,ラララ…
Dialogue: 0,0:08:56.47,0:08:59.12,Default,,0,0,0,,ラララ…
Dialogue: 0,0:08:59.32,0:09:01.99,Default,,0,0,0,,ラララララ…
Dialogue: 0,0:09:02.07,0:09:04.77,Default,,0,0,0,,ラララ…
Dialogue: 0,0:09:04.82,0:09:07.40,Default,,0,0,0,,ラララ…
Dialogue: 0,0:09:07.47,0:09:09.92,Default,,0,0,0,,ラララ…
Dialogue: 0,0:09:09.96,0:09:12.40,Default,,0,0,0,,ラララララ…
Dialogue: 0,0:09:12.43,0:09:17.26,Default,,0,0,0,,（♪～）
Dialogue: 0,0:09:22.00,0:09:24.26,Default,,0,0,0,,（♪～）
Dialogue: 0,0:09:24.38,0:09:26.77,Default,,0,0,0,,カラカラカラの中 バララバラバラ
Dialogue: 0,0:09:26.79,0:09:29.09,Default,,0,0,0,,鳴っている 鳴っている カラの中バラバラ
Dialogue: 0,0:09:29.17,0:09:33.94,Default,,0,0,0,,小さな鈴が 割っている割っている カラのからだの中
Dialogue: 0,0:09:33.99,0:09:36.28,Default,,0,0,0,,カラカラカラの中 バララバラバラ
Dialogue: 0,0:09:36.31,0:09:38.72,Default,,0,0,0,,ぐるぐる回って カラの中バラバラ
Dialogue: 0,0:09:38.79,0:09:43.40,Default,,0,0,0,,黄身と白身が ごちゃごちゃ ごちゃごちゃ 漏れてくるドロドロ
Dialogue: 0,0:09:43.54,0:09:45.83,Default,,0,0,0,,ッタケタ ケタタケタ けたた たましく
Dialogue: 0,0:09:45.86,0:09:48.33,Default,,0,0,0,,ぐるぐる回って 恥ずかしくケタケタ
Dialogue: 0,0:09:48.39,0:09:53.01,Default,,0,0,0,,ぼくらずっと 鳴ってるよ 泣いてるよ 恥ずかしくケタケタ
Dialogue: 0,0:09:53.08,0:09:55.55,Default,,0,0,0,,カラカラカラのカラ カララカラカラ
Dialogue: 0,0:09:55.62,0:09:57.93,Default,,0,0,0,,カラカラ カラカラ からっぽがこわくて
Dialogue: 0,0:09:58.00,0:10:00.35,Default,,0,0,0,,きみも ぼくも
Dialogue: 0,0:10:00.40,0:10:02.63,Default,,0,0,0,,鳴っている 泣いている 鳴っている 泣いている
Dialogue: 0,0:10:02.68,0:10:05.15,Default,,0,0,0,,割れてる 笑ってる 割れてる 笑ってる
Dialogue: 0,0:10:05.18,0:10:07.39,Default,,0,0,0,,楽しく 楽しく 楽しく 楽しく
Dialogue: 0,0:10:07.46,0:10:09.98,Default,,0,0,0,,だからからか だからか カラのからだだから
Dialogue: 0,0:10:10.01,0:10:13.28,Default,,0,0,0,,そばにいて 眠れない…
Dialogue: 0,0:10:13.32,0:10:20.89,Default,,0,0,0,,眠れない… 眠れない…
Dialogue: 0,0:10:26.17,0:10:27.65,Default,,0,0,0,,眠れ眠れ
Dialogue: 0,0:10:27.68,0:10:36.08,Default,,0,0,0,,眠れなー…
Dialogue: 0,0:10:36.11,0:10:37.77,Default,,0,0,0,,い
Dialogue: 0,0:10:39.51,0:10:44.59,Default,,0,0,0,,あっあ 眠れない
Dialogue: 0,0:10:56.63,0:10:58.60,Default,,0,0,0,,ケッタッタラタ カッカンカラカ…
Dialogue: 0,0:10:58.63,0:11:00.61,Default,,0,0,0,,ケッタッタラタ カッカンカラカ…
Dialogue: 0,0:11:00.64,0:11:02.56,Default,,0,0,0,,ケッタッタラタ カッカンカラカ…
Dialogue: 0,0:11:02.62,0:11:04.56,Default,,0,0,0,,ケッタッタラタ カッカンカラカ…
Dialogue: 0,0:11:04.60,0:11:06.53,Default,,0,0,0,,ナーナーナラナ ヌーナーナラナ…
